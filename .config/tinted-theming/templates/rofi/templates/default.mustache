* {
    base00: #{{base00-hex}};
    base01: #{{base01-hex}};
    base02: #{{base02-hex}};
    base03: #{{base03-hex}};
    base04: #{{base04-hex}};
    base05: #{{base05-hex}};
    base06: #{{base06-hex}};
    base07: #{{base07-hex}};
    base08: #{{base08-hex}};
    base09: #{{base09-hex}};
    base0A: #{{base0A-hex}};
    base0B: #{{base0B-hex}};
    base0C: #{{base0C-hex}};
    base0D: #{{base0D-hex}};
    base0E: #{{base0E-hex}};
    base0F: #{{base0F-hex}};

    background-color: transparent;
    text-color: @base05;
}

window {
    width: 60%;
    background-color: @base00;

    border: 1px;
    border-color: @base03;

    padding: 4px;
}

mainbox {
    background-color: @base00;
    spacing: 0px;
    padding: 0px;
}

inputbar {
    background-color: @base00;
    text-color: @base05;

    padding: 3px 5px;
    margin: 0px 0px 3px 0px;

    border: 0px 0px 1px 0px;
    border-color: @base03;

    children: [ prompt, entry, case-indicator ];
}

prompt {
    background-color: transparent;
    text-color: @base05;
}

entry {
    background-color: transparent;
    text-color: @base05;
}

case-indicator {
    background-color: transparent;
    text-color: @base03;
}

message {
    background-color: @base00;
}

textbox {
    background-color: @base00;
    text-color: @base05;
}

listview {
    background-color: @base00;

    spacing: 0px;
    padding: 0px;

    border: 0px;
}

element {
    background-color: @base00;
    text-color: @base05;

    border: 0px;
    margin: 0px;
    padding: 3px 6px;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element normal.normal {
    background-color: @base00;
    text-color: @base05;
}

element alternate.normal {
    background-color: @base00;
    text-color: @base05;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: #20252b;
    text-color: #eeeeee;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    background-color: transparent;
    text-color: #eeeeee;
}
