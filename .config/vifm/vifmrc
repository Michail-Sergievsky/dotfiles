"----Keyboard Mappings-------------{{{

" `<wait>` introduces a mapping timeout
" `<wait>` has no effect on single-character mappings
" `<silent>` suppresses command-line echo

" Ctrl
" Swap the current pane with the other pane
nnoremap <C-f> <c-w>x
" Synchronize the other pane to the current directory
nnoremap <C-b> :sync<CR>
" Disable Ctrl-N and Ctrl-P
nnoremap <C-n> <Nop>
nnoremap <C-p> <Nop>
" nnoremap <C-t> :tabnew<cr>
" nnoremap <C-c> :tabclose<cr>
" nnoremap <C-p> gT
" nnoremap <C-n> gt
" Move between Vifm panes and tmux panes
nnoremap <silent> <C-h> :if paneisat('left')   | execute '!tmux select-pane -L %i' | else | execute 'wincmd h' | endif<cr>
nnoremap <silent> <C-j> :if paneisat('bottom') | execute '!tmux select-pane -D %i' | else | execute 'wincmd j' | endif<cr>
nnoremap <silent> <C-k> :if paneisat('top')    | execute '!tmux select-pane -U %i' | else | execute 'wincmd k' | endif<cr>
nnoremap <silent> <C-l> :if paneisat('right')  | execute '!tmux select-pane -R %i' | else | execute 'wincmd l' | endif<cr>
" Handle the Ctrl-H / Backspace terminal-key conflict
nnoremap <silent> <bs>  :if paneisat('left')   | execute '!tmux select-pane -L %i' | else | execute 'wincmd h' | endif<cr>
" Alt
" Disabled previous-directory Alt mappings
" nnoremap <A-p> [R
" nnoremap <A-n> ]R

" Other symbols
" Resize panes with -, _, and |
nnoremap - <C-w>5<
nnoremap _ <C-w>5>
nnoremap | <C-w>5=
" Toggle selection and move down
nnoremap <space> tj
" Open Vifm help
nnoremap ~ :help<cr>

