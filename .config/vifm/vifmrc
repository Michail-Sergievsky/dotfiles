"------Setup-----------------{{{
" Ignore case for f/F/;/,
set caseoptions=g

" Delete files without confirmation
set confirm=""

" Show directory sizes
set dirsize=size

" Hide the parent-directory entry (`..`)
set dotdirs=

" Show dotfiles
set dotfiles

" Allow abbreviated unambiguous external commands with `:!`
set fastrun

" Keep up to 1000 entries in Vifm histories
set history=1000

" Ignore case in search pattern unless it contains at least one uppercase letter
set ignorecase
set smartcase

" Search and filter incrementally while typing
set incsearch

" Follow symlinks automatically on `l` or Enter
set nofollowlinks

" Don't highlight search results automatically
set nohlsearch

" Don't wrap long lines in preview pane
set nowrap

" Show absolute line numbers
set number

" Show relative line numbers in addition to the current absolute line
set relativenumber

" Custom ruler format
set rulerformat='%2l-%S%[ +%x%]'

" Allow executable files to run directly
set runexec

" Keep four lines of context above and below the cursor
set scrolloff=4

" Sort numeric parts of filenames naturally
set sortnumbers

" Enable suggestions in supported Vifm contexts
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers

" Perform file operations via system calls
set syscalls

" Display tab characters as two columns
set tabstop=2

" Format for displaying time
set timefmt="%y/%m/%d %H:%M"

" Update terminal title
set title

" Use trash directory per mount point, fallback to ~/.vifm-trash
set trashdir=%r/.vifm-trash,$HOME/.vifm-trash

" Keep up to 100 undo levels
set undolevels=100

" Use vim's documentation system for :help command
" set vimhelp

" Persist selected state between Vifm sessions
set vifminfo=dhistory,savedirs,chistory,state,tui,shistory,
    \phistory,fhistory,dirstack,registers,bookmarks,bmarks

" Show completion matches in command-line mode
set wildmenu

" Use popup window instead of a single line for completion
set wildstyle=popup

" Reduce requests to slow file systems
if !has('win')
    set slowfs=curlftpfs
endif

" Use this directory for FUSE mount points
set fusehome=~/.local/state/vifm/fuse

" Ignore .git directory on :find
set findprg='find %s %a -print ,
            \ -type d \( ! -readable -o ! -executable -o -path "*/.git" \)
            \ -prune'
" Mark shell sessions launched from Vifm
let $INSIDE_VIFM = 'true'

" Open files in Neovim in a separate Kitty window without blocking Vifm
" set vicmd="kitty -e vim $VIMARGS --remote-tab-silent >/dev/null 2>&1 &"
"set vicmd="kitty -e nvim &"
set vicmd=nvim


