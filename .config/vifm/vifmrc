" ----Commands------------------{{{
" Load Vifm commands generated from Bash aliases
so ~/.config/vifm/vifm_aliases
" Example: extract selected archives silently in the background
" command extract aunpack -e %f &>/dev/null &
" Extract selected archives
command extract aunpack %f &>/dev/null &
" Archive the selection with :archive <filename.ext>
command archive apack %a %f &>/dev/null &
" Run Git commands against the bare dotfiles repository
command! config /usr/bin/git --git-dir=$HOME/.myconf/ --work-tree=$HOME %a %S
" Show filesystem usage for the current mount point
command! df df -h %m 2> /dev/null
" Open selected files from both panes in Neovim diff mode
command! diff nvim -d %f %F
" Run a command once for each selected file
" Example: `%foreach echo "$f"`
command! foreach for f in %f; do %a; done
" Run make in current directory
command! make !!make %a
" Create a directory and enter it
command! mkcd :mkdir %a | cd %a
" List mounted filesystems
command! mounts /bin/lsblk -no MOUNTPOINT|sed '/^$/d'|sed '/\[SWAP\]/d'|sort|uniq %M
" Create a symbolic link in the other pane
command! link :alink
" Print selected files double-sided
command! print lp -n 1 -o sides=two-sided-long-edge %f
" Save the Vifm configuration and restart Vifm
command! reload :write | restart full
" Run script
command! run !! ./%f
" Replace spaces and reserved filename characters with underscores
command! sanitize :tr/ ?<>\\:*|"/__________
" Set the legacy Vim server target to `MAIN`
command! targetm :let $VIMARGS = '--servername MAIN'
" Set the legacy Vim server target from command arguments
command! target :let $VIMARGS = '--servername "%a"'
" Create a ZIP archive from selected files
command! zip zip -r %f.zip %f
" Play all video files below the current directory with mpv
command! mpvop find . -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.avi" -o -iname "*.webm" -o -iname "*.mov" -o -iname "*.flv" -o -name "*.m4v" \) -exec mpv {} + &
" comics_fetcher
command! cvmarvel !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --marvel
command! cvdc     !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --dc
command! cvother  !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --other


" Disabled helper scripts
" command! cvmarvel !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --marvel
" command! cvdc     !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --dc
" command! cvother  !python3 ~/.config/vifm/scripts/cv_oneshot_sorter.py %f --other

" Search indexed files with plocate and fzf
" Enter directories directly and open files with `goto`
command! fzflocate : set noquickview
                  \| let $FZF_PICK = term('locate $HOME | fzf --height 30 2>/dev/tty')
                  \| if $FZF_PICK != ''
                  \|     execute system('[ -f "$FZF_PICK" ] && echo goto || echo cd') fnameescape($FZF_PICK)
                  \| endif
" Search files with fd and fzf
command! fzffind : set noquickview
                \| let $FZF_PICK = term('fd | fzf --height 30 2>/dev/tty')
                \| if $FZF_PICK != ''
                \|     execute 'goto' fnameescape($FZF_PICK)
                \| endif
" Search directories with fd and fzf, then enter the result
command! fzfcd : let $FZF_RES = term('fd --type d . %a --hidden --exclude .git | fzf 2> /dev/tty')
              \| if $FZF_RES != ''
              \|     execute 'cd' fnameescape($FZF_RES)
              \| endif
" Learn visited directories and offer an interactive zoxide jump.
" Keep ordinary cd, marks, fc and preview settings unchanged.
if executable('zoxide')
    autocmd DirEnter * !zoxide add -- %d %i
    if executable('fzf')
        command! ZcdI : let g:zoxide_pick = term('zoxide query --interactive 2>/dev/tty')
                     \| if g:zoxide_pick != ''
                     \|     execute 'cd' fnameescape(g:zoxide_pick)
                     \| endif
        nnoremap <silent> ,z :ZcdI<cr>
    endif
endif

" Search text inside files in the current directory with ripgrep and fzf
command! fzfinfiles :let $FZF_PICK = term('vifm_fzfsearchtextfiles.sh 2>/dev/tty')
                   \| if $FZF_PICK != ''
                   \|     execute 'goto' fnameescape($FZF_PICK)
                   \| endif
" Search the media database with ripgrep and fzf
command! fzfinmedia :let $FZF_PICK = term('vifm_fzfsearchmedia.sh 2>/dev/tty')
                   \| if $FZF_PICK != ''
                   \|     execute 'goto' fnameescape($FZF_PICK)
                   \| endif

" Search text inside PDF files with pdfgrep and fzf
command! fzfinpdffiles :let $FZF_PICK = term('vifm_fzfsearchpdffiles.sh 2>/dev/tty')
                   \| if $FZF_PICK != ''
                   \|     execute 'goto' fnameescape($FZF_PICK)
                   \| endif
" Cycle sorting between name, size, and modification time
command! togglesort
         \ :if &sort == '-size,+name'
         \ |    set sort=+mtime
         \ |    echo 'Sorted by modification date'
         \ |elseif &sort == '+iname'
         \ |    set sort=-size
         \ |    echo 'Sorted by size'
         \ |else
         \ |    set sort=+iname
         \ |    echo 'Sorted by name'
         \ |endif
" Run Vifm's internal comparison helper
command! cmpinternal vifm_compare-cmd %a %S
" ?
command! cmp : if expand('%%c') == expand('%%f')
              \ |     echo expand('Comparing %%"c and %%"C:t ...')
              \ |     cmpinternal %c %C
              \ | else
              \ |     echo expand('Comparing files: %%"f ...')
              \ |     cmpinternal %f \ | endif

" WORK
" Mount a remote directory with SSHFS and enter it
command! mountssh :!mkdir -p ~/mnt/remote && sshfs user@host:/path ~/mnt/remote && cd ~/mnt/remote
