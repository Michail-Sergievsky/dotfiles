"----Status line ----{{{

if $INSIDE_VIFM != ''
    let $SL_PREFIX = 'vifm'
else
    if $PS1 != ''
        let $SL_PREFIX = 'bash'
    endif
    let $INSIDE_VIFM = 'true'
endif

let &statusline = ''

" LEFT

" Dark
let &statusline .= '%1* '.$SL_PREFIX.' '

" Dark -> light
let &statusline .= '%3*'

" Light
let &statusline .= '%2* %t%[ -> %T%] '

" Light -> dark
let &statusline .= '%4*'

" Dark middle
let &statusline .= '%1*'
let &statusline .= '%='


" RIGHT

" Dark
let &statusline .= '%1* %A '
let &statusline .= '%[%u:%g%] '

" Current-file size, separated within the existing dark block
let &statusline .= ' %-s '

" Dark -> light
let &statusline .= '%4*'

" Light: selected-files total
let &statusline .= '%2* %E '

" Light -> dark
let &statusline .= '%3*'

" Dark
let &statusline .= '%1* %d '

" Dark -> light
let &statusline .= '%4*'

" Light
let &statusline .= '%2* %a '

" Append selection/filter state to the status line
set statusline+='%[ +%x%]'

