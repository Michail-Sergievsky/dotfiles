* {
    base00: #161b1d;
    base01: #1f292e;
    base02: #516d7b;
    base03: #5a7b8c;
    base04: #7195a8;
    base05: #7ea2b4;
    base06: #c1e4f6;
    base07: #ebf8ff;
    base08: #d22d72;
    base09: #935c25;
    base0A: #8a8a0f;
    base0B: #568c3b;
    base0C: #2d8f6f;
    base0D: #257fad;
    base0E: #6b6bb8;
    base0F: #b72dd2;

    background-color: transparent;
    text-color: @base05;
}

window {
    width: 60%;
    background-color: @base00;

    border: 1px;
    border-color: @base03;

    padding: 4px;
}

mainbox {
    background-color: @base00;
    spacing: 0px;
    padding: 0px;
}

inputbar {
    background-color: @base00;
    text-color: @base05;

    padding: 3px 5px;
    margin: 0px 0px 3px 0px;

    border: 0px 0px 1px 0px;
    border-color: @base03;

    children: [ prompt, entry, case-indicator ];
}

prompt {
    background-color: transparent;
    text-color: @base05;
}

entry {
    background-color: transparent;
    text-color: @base05;
}

case-indicator {
    background-color: transparent;
    text-color: @base03;
}

message {
    background-color: @base00;
}

textbox {
    background-color: @base00;
    text-color: @base05;
}

listview {
    background-color: @base00;

    spacing: 0px;
    padding: 0px;

    border: 0px;
}

element {
    background-color: @base00;
    text-color: @base05;

    border: 0px;
    margin: 0px;
    padding: 3px 6px;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element normal.normal {
    background-color: @base00;
    text-color: @base05;
}

element alternate.normal {
    background-color: @base00;
    text-color: @base05;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: #20252b;
    text-color: #eeeeee;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    background-color: transparent;
    text-color: #eeeeee;
}
