#---------Shutdown, reboot, lock screen{{{
# set $Locker swaylock -f && sleep 1
set $Locker $HOME/.scripts/sway_lock.sh

set $mode_system System (l) lock, (Shift+e) logout, (s) suspend, (h) hibernate, (Shift+r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    $bind l exec --no-startup-id $Locker, mode "default"
    $bind Shift+e exec --no-startup-id swaymsg exit, mode "default"
    $bind s exec --no-startup-id sh -c '"$HOME/.scripts/sway_lock.sh" --wait-ready && systemctl suspend', mode "default"
    # bindsym h exec --no-startup-id $Locker && systemctl hibernate, mode "default"
    $bind h exec --no-startup-id sh -c '"$HOME/.scripts/sway_lock.sh" --wait-ready && systemctl hibernate', mode "default"
    $bind Shift+r exec --no-startup-id systemctl reboot, mode "default"
    $bind Shift+s exec --no-startup-id systemctl poweroff -i, mode "default"

    # back to normal: Enter or Escape
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+Pause mode "$mode_system"
bindsym $mod+Home mode "$mode_system"
#}}}
#-------- Reload mode{{{

set $mode_reload Reload (s) Sway, (w) Waybar, (n) night color, (Shift+n) night color off, (i) swayidle, (Shift+r) restart Sway

mode "$mode_reload" {

    # Reload Sway config
    $bind s reload; mode "default"

    # Restart Waybar
    $bind w exec --no-startup-id $HOME/.scripts/waybar_launch.sh; mode "default"

    # Restart night color adjustment
    $bind n exec --no-startup-id sh -c 'pkill -x wlsunset; wlsunset -T 5700 -t 3500 -g 0.9 -l 44.99 -L 41.93'; mode "default"

    # Disable night color adjustment
    $bind Shift+n exec --no-startup-id pkill -x wlsunset; mode "default"

    # Restart swayidle
    $bind i exec --no-startup-id $HOME/.scripts/sway_idle.sh; mode "default"

    # Restart Sway itself
    $bind Shift+r restart; mode "default"

    # Exit reload mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

$bind $mod+r mode "$mode_reload"

