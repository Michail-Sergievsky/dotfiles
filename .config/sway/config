#---------Basic Definitions--{{{

set $mod Mod4
set $alt Mod1
set $term $TERMINAL
set $border_no_name border pixel 5
set $border_normal border normal 5
set $bind bindsym --to-code

#}}}
#---------Basis Setup [fonts, windows]--{{{

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Droid Sans Mono 11

#Automatic back-and-forth between workspace
workspace_auto_back_and_forth yes

#Diseable window title [in title mode!]
#default_border pixel

# Configure border style <normal|1pixel|pixel xx|none|pixel>
# for_window [class=".*"] $border_no_name
for_window [app_id=".*"] $border_normal
for_window [class=".*"] $border_normal
for_window [class="^PacketTracer$"] $border_normal
for_window [class="^PacketTracer$"] floating enable

# Hide borders <none|vertical|horizontal|both|smart>
hide_edge_borders none

# set popup behaviour during full screen <smart|ignore|leave_fullscreen>
popup_during_fullscreen leave_fullscreen

# set preferred focus_wrapping <yes|no|force>
#focus_wrapping yes

#}}}
#---------Colors--{{{
# Generated by Tinty
include ~/.config/sway/colors.conf

#                                       border   background   text     indicator   child_border
client.focused                          $base05  $base0D      $base00  $base0D     $base0D
client.focused_inactive                 $base01  $base01      $base05  $base03     $base01
client.unfocused                        $base01  $base00      $base05  $base01     $base01
client.urgent                           $base08  $base08      $base00  $base08     $base08
client.placeholder                      $base00  $base00      $base05  $base00     $base00
client.background                       $base07


#}}}
#---------Desktop ENVIRONMENT--{{{

# Activation environment for user services and D-Bus clients.
# Keep DISPLAY for applications using XWayland.
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK DISPLAY XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland

# Monitor layout
exec --no-startup-id kanshi
exec --no-startup-id $HOME/.scripts/sway_output_watcher.sh

# Waybar is launch from kanshi

# Wallpaper
output * bg $HOME/.wallpapers/wp4657311-arch-solarized-wallpapers.png fill

# eng-rus keyboard layout

input type:keyboard {
    xkb_layout us,ru
    xkb_variant ,winkeys
    xkb_options grp_led:scroll
}

bindsym Ctrl+Shift+space input type:keyboard xkb_switch_layout next

# Monitor power management: turn off after 45 minutes idle; no idle locking
exec_always --no-startup-id $HOME/.scripts/sway_idle.sh


