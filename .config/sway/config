#Floats for windows
for_window [app_id="lxqt-policykit-agent"] floating enable
for_window [app_id="lxqt-policykit-agent"] resize set width 450 height 250
for_window [app_id="lxqt-policykit-agent"] move position center
for_window [app_id="io.github.xiaoyifang.goldendict_ng"] floating enable
# Thunderbird dialogs
for_window [app_id="org.mozilla.Thunderbird" title=".*Enter your password.*"] floating enable
# Keep the Thunderbird calendar reminder window compact instead of tiling it.
for_window [app_id="org.mozilla.Thunderbird" title="^[0-9]+ Reminders?$"] floating enable
for_window [app_id="org.mozilla.Thunderbird" title="^[0-9]+ Reminders?$"] resize set width 720 height 460
for_window [app_id="org.mozilla.Thunderbird" title="^[0-9]+ Reminders?$"] move position center
# Thunderbird calendar subscription wizard (native Wayland has no window_role).
for_window [app_id="org.mozilla.Thunderbird" title="^Add calendar$"] floating enable
for_window [app_id="org.mozilla.Thunderbird" title="^Add calendar$"] resize set width 760 height 540
for_window [app_id="org.mozilla.Thunderbird" title="^Add calendar$"] move position center
# New-mail alerts size themselves and snap to the lower-right corner.  Native
# Wayland Thunderbird does not expose window_role, so match its alert titles.
for_window [app_id="org.mozilla.Thunderbird" title="^$"] floating enable
for_window [app_id="org.mozilla.Thunderbird" title="^$"] move position 1310 950
for_window [app_id="org.mozilla.Thunderbird" title="^New Mail Notification$"] floating enable
for_window [app_id="org.mozilla.Thunderbird" title="^New Mail Notification$"] move position 1310 950
for_window [app_id="org.mozilla.Thunderbird" title="(?i).* received [0-9]+ new messages?$"] floating enable
