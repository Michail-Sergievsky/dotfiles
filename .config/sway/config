# the lower-right of this 1920x1080 output, leaving a small margin.
for_window [app_id="org.mozilla.Thunderbird" title="(?i).* received [0-9]+ new messages?$"] move position 1310 950
# Keep the X11 fallback for Thunderbird and other legacy dialog windows.
for_window [window_role="(?i)(?:pop-up|setup|prefwindow|task_dialog|alert(?::alert)?)"] floating enable
