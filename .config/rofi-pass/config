# Fields
URL_FIELD='url'
USERNAME_FIELD='user'
AUTOTYPE_FIELD='autotype'

# Timing
delay=2
wait=0.2
type_delay=12

# Programs
EDITOR='kitty -e nvim'
BROWSER='xdg-open'

# New entries
edit_new_pass="true"

# Your password-store layout:
# media/nexusmods.com/Lisandus
default_user=':basename'

# Autotype basename(username), Tab, password
